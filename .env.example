# Sao chép tệp này thành .env rồi đổi các giá trị bên dưới.
# Tệp .env không được đưa lên Git.

# Mật khẩu tài khoản sa của SQL Server (ít nhất 8 ký tự, có chữ hoa, chữ thường, số và ký hiệu)
SQL_SA_PASSWORD=Doi_MatKhau_123
# Mật khẩu tài khoản civ09_app mà máy chủ ứng dụng dùng để kết nối CSDL (không dùng sa)
SQL_APP_PASSWORD=Doi_MatKhau_UngDung_123
# Cổng SQL Server trên máy (để 14330 cho khỏi trùng SQL Server cài sẵn)
SQL_PORT=14330

# Tài khoản quản trị Keycloak tại http://127.0.0.1:8080 (tên đăng nhập: admin)
KEYCLOAK_ADMIN_PASSWORD=Doi_MatKhau_Admin_123
# Khóa bí mật của client civ09-web, dùng chung cho Keycloak và máy chủ ứng dụng
KEYCLOAK_CLIENT_SECRET=doi-khoa-bi-mat-client-civ09
# Mật khẩu chung của các tài khoản mẫu (daidien1, dieuphoi1, tnv1, ...)
DEMO_PASSWORD=Demo@123
