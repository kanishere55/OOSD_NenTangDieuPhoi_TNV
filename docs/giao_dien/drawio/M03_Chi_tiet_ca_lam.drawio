920" height="236" as="geometry"/></mxCell><mxCell id="15" value="Hướng dẫn dùng điện thoại thông minh cho người lớn tuổi" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontSize=20;fontStyle=1;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="56" y="142" width="880" height="32" as="geometry"/></mxCell><mxCell id="16" value="Do Nhóm Thiện nguyện Phường An Bình đăng" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontSize=12;fontStyle=0;fontColor=#555555;" vertex="1" parent="1"><mxGeometry x="56" y="176" width="880" height="20" as="geometry"/></mxCell><mxCell id="17" value="Hướng dẫn các cô chú lớn tuổi gọi video, nhắn tin và tra cứu thông tin y tế trên điện thoại." style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontSize=12;fontStyle=0;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="56" y="198" width="880" height="20" as="geometry"/></mxCell><mxCell id="18" value="Thời gian" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontSize=12;fontStyle=0;fontColor=#555555;" vertex="1" parent="1"><mxGeometry x="56" y="228" width="150" height="22" as="geometry"/></mxCell><mxCell id="19" value="Thứ ba, 17/11/2026, từ 08:00 đến 10:00" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontSize=12;fontStyle=1;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="210" y="228" width="600" height="22" as="geometry"/></mxCell><mxCell id="20" value="Khu vực" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontSize=12;fontStyle=0;fontColor=#555555;" vertex="1" parent="1"><mxGeometry x="56" y="252" width="150" height="22" as="geometry"/></mxCell><mxCell id="21" value="Phường An Bình" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontSize=12;fontStyle=1;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="210" y="252" width="600" height="22" as="geometry"/></mxCell><mxCell id="22" value="Số người" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontSize=12;fontStyle=0;fontColor=#555555;" vertex="1" parent="1"><mxGeometry x="56" y="276" width="150" height="22" as="geometry"/></mxCell><mxCell id="23" value="Cần 2 người, còn 2 chỗ" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontSize=12;fontStyle=1;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="210" y="276" width="600" height="22" as="geometry"/></mxCell><mxCell id="24" value="Kỹ năng cần có" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontSize=12;fontStyle=0;fontColor=#555555;" vertex="1" parent="1"><mxGeometry x="56" y="300" width="150" height="22" as="geometry"/></mxCell><mxCell id="25" value="Tin học cơ bản" style="rounded=1;whiteSpace=wrap;html=1;arcSize=50;fontSize=11;fontStyle=1;fillColor=#e6e6e6;strokeColor=#666666;" vertex="1" parent="1"><mxGeometry x="210" y="301" width="112" height="20" as="geometry"/></mxCell><mxCell id="26" value="Địa điểm cụ thể và hướng dẫn chi tiết chỉ hiện cho người đã được phân công vào ca." style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontSize=12;fontStyle=0;fontColor=#555555;" vertex="1" parent="1"><mxGeometry x="56" y="330" width="880" height="20" as="geometry"/></mxCell><mxCell id="27" value="" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;" vertex="1" parent="1"><mxGeometry x="40" y="380" width="920" height="128" as="geometry"/></mxCell><mxCell id="28" value="Tham gia ca này" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontSize=15;fontStyle=1;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="56" y="388" width="600" height="26" as="geometry"/></mxCell><mxCell id="29" value="Bạn có đủ kỹ năng mà ca yêu cầu. Sau khi đăng ký, điều phối viên sẽ xem xét và phân công." style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontSize=12;fontStyle=0;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="56" y="420" width="860" height="20" as="geometry"/></mxCell><mxCell id="30" value="Đăng ký tham gia" style="rounded=1;whiteSpace=wrap;html=1;arcSize=18;fontSize=12;fillColor=#4d4d4d;strokeColor=#333333;fontColor=#ffffff;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="56" y="452" width="141" height="38" as="geometry"/></mxCell><mxCell id="31" value="Phần &quot;Tham gia ca này&quot; đổi theo người xem:" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontSize=12;fontStyle=1;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="40" y="522" width="920" height="20" as="geometry"/></mxCell><mxCell id="32" value="–  Khách: nút Đăng nhập để đăng ký và nút Tôi chưa có tài khoản." style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontSize=12;fontStyle=0;fontColor=#555555;" vertex="1" parent="1"><mxGeometry x="56" y="546" width="900" height="20" as="geometry"/></mxCell><mxCell id="33" value="–  Tình nguyện viên thiếu kỹ năng: thông báo nêu kỹ năng còn thiếu và nút Cập nhật kỹ năng, không có nút đăng ký." style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontSize=12;fontStyle=0;fontColor=#555555;" vertex="1" parent="1"><mxGeometry x="56" y="568" width="900" height="20" as="geometry"/></mxCell><mxCell id="34" value="–  Đã đăng ký: hiện trạng thái Chờ duyệt hoặc Đã phân công; khi đã phân công có nút Xem hướng dẫn riêng." style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontSize=12;fontStyle=0;fontColor=#555555;" vertex="1" parent="1"><mxGeometry x="56" y="590" width="900" height="20" as="geometry"/></mxCell><mxCell id="35" value="" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#333333;" vertex="1" parent="1"><mxGeometry x="0" y="634" width="1000" height="30" as="geometry"/></mxCell><mxCell id="36" value="Nền tảng điều phối tình nguyện viên theo kỹ năng. Giờ hiển thị trên trang là giờ Việt Nam." style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontSize=10;fontStyle=0;fontColor=#555555;" vertex="1" parent="1"><mxGeometry x="20" y="638" width="700" height="22" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>