lor=#333333;fontColor=#ffffff;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="645" y="326" width="105" height="30" as="geometry"/></mxCell><mxCell id="22" value="Không, quay lại" style="rounded=1;whiteSpace=wrap;html=1;arcSize=18;fontSize=12;fillColor=#ffffff;strokeColor=#333333;fontColor=#000000;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="503" y="326" width="134" height="30" as="geometry"/></mxCell><mxCell id="23" value="" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#333333;" vertex="1" parent="1"><mxGeometry x="0" y="440" width="1000" height="30" as="geometry"/></mxCell><mxCell id="24" value="Nền tảng điều phối tình nguyện viên theo kỹ năng. Giờ hiển thị trên trang là giờ Việt Nam." style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontSize=10;fontStyle=0;fontColor=#555555;" vertex="1" parent="1"><mxGeometry x="20" y="444" width="700" height="22" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>