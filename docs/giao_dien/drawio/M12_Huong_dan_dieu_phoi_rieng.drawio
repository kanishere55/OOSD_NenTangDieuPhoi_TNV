 y="114" width="600" height="32" as="geometry"/></mxCell><mxCell id="15" value="Ca làm" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontSize=12;fontStyle=0;fontColor=#555555;" vertex="1" parent="1"><mxGeometry x="56" y="156" width="110" height="22" as="geometry"/></mxCell><mxCell id="16" value="Hướng dẫn dùng điện thoại thông minh cho người lớn tuổi" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontSize=12;fontStyle=1;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="170" y="156" width="490" height="22" as="geometry"/></mxCell><mxCell id="17" value="Thời gian" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontSize=12;fontStyle=0;fontColor=#555555;" vertex="1" parent="1"><mxGeometry x="56" y="180" width="110" height="22" as="geometry"/></mxCell><mxCell id="18" value="Thứ năm, 19/11/2026, từ 08:00 đến 11:00" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontSize=12;fontStyle=1;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="170" y="180" width="490" height="22" as="geometry"/></mxCell><mxCell id="19" value="" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f7f7f7;strokeColor=#666666;dashed=1;" vertex="1" parent="1"><mxGeometry x="56" y="212" width="608" height="76" as="geometry"/></mxCell><mxCell id="20" value="Địa điểm: nhà văn hóa khu phố 3, cửa bên hông. Liên hệ chị Mai khi đến. Một số cô chú nghe kém, cần nói chậm và rõ." style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontSize=13;fontStyle=0;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="68" y="218" width="584" height="62" as="geometry"/></mxCell><mxCell id="21" value="Nội dung này chỉ dành cho người tham gia ca. Xin không chụp lại hay chia sẻ ra ngoài." style="rounded=0;whiteSpace=wrap;html=1;align=left;spacingLeft=10;fontSize=12;fillColor=#f5f5f5;strokeColor=#333333;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="56" y="300" width="608" height="32" as="geometry"/></mxCell><mxCell id="22" value="‹ Quay lại trang trước" style="rounded=1;whiteSpace=wrap;html=1;arcSize=18;fontSize=12;fillColor=#ffffff;strokeColor=#333333;fontColor=#000000;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="56" y="346" width="184" height="30" as="geometry"/></mxCell><mxCell id="23" value="" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;" vertex="1" parent="1"><mxGeometry x="700" y="106" width="260" height="190" as="geometry"/></mxCell><mxCell id="24" value="Khi không có quyền xem" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontSize=12;fontStyle=1;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="712" y="114" width="240" height="20" as="geometry"/></mxCell><mxCell id="25" value="Bạn không có quyền xem hướng dẫn riêng của ca này. Chỉ thành viên của tổ chức sở hữu và người đã được phân công (trước giờ kết thúc ca) mới được xem." style="rounded=0;whiteSpace=wrap;html=1;align=left;spacingLeft=10;fontSize=12;fillColor=#f5f5f5;strokeColor=#333333;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="712" y="140" width="236" height="104" as="geometry"/></mxCell><mxCell id="26" value="Không hiện nội dung hướng dẫn, chỉ có nút Quay lại." style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontSize=11;fontStyle=0;fontColor=#555555;" vertex="1" parent="1"><mxGeometry x="712" y="252" width="240" height="36" as="geometry"/></mxCell><mxCell id="27" value="" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#333333;" vertex="1" parent="1"><mxGeometry x="0" y="430" width="1000" height="30" as="geometry"/></mxCell><mxCell id="28" value="Nền tảng điều phối tình nguyện viên theo kỹ năng. Giờ hiển thị trên trang là giờ Việt Nam." style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontSize=10;fontStyle=0;fontColor=#555555;" vertex="1" parent="1"><mxGeometry x="20" y="434" width="700" height="22" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>