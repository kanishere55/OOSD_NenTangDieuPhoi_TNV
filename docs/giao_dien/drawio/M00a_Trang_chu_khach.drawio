Color=#000000;" vertex="1" parent="1"><mxGeometry x="672" y="554" width="276" height="20" as="geometry"/></mxCell><mxCell id="43" value="Cần 3 người, còn 3 chỗ" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontSize=12;fontStyle=0;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="672" y="576" width="276" height="20" as="geometry"/></mxCell><mxCell id="44" value="Xem tất cả 5 ca đang mở" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontSize=12;fontStyle=4;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="40" y="608" width="400" height="20" as="geometry"/></mxCell><mxCell id="45" value="Dành cho tổ chức cộng đồng" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontSize=15;fontStyle=1;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="40" y="638" width="900" height="26" as="geometry"/></mxCell><mxCell id="46" value="Tài khoản của đại diện và điều phối viên do nền tảng cấp cho từng tổ chức. Nếu tổ chức của bạn đã có tài khoản, hãy bấm Đăng nhập ở góc trên bên phải để đăng nhu cầu, tạo ca và phân công tình nguyện viên." style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontSize=12;fontStyle=0;fontColor=#555555;" vertex="1" parent="1"><mxGeometry x="40" y="666" width="760" height="42" as="geometry"/></mxCell><mxCell id="47" value="" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#333333;" vertex="1" parent="1"><mxGeometry x="0" y="732" width="1000" height="30" as="geometry"/></mxCell><mxCell id="48" value="Nền tảng điều phối tình nguyện viên theo kỹ năng. Giờ hiển thị trên trang là giờ Việt Nam." style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontSize=10;fontStyle=0;fontColor=#555555;" vertex="1" parent="1"><mxGeometry x="20"