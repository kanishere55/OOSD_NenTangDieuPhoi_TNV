"><mxGeometry x="40" y="170" width="72" height="20" as="geometry"/></mxCell><mxCell id="15" value="Chưa ai ngoài tổ chức nhìn thấy. Cần rà soát rồi công bố." style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontSize=12;fontStyle=0;fontColor=#555555;" vertex="1" parent="1"><mxGeometry x="120" y="170" width="600" height="20" as="geometry"/></mxCell><mxCell id="16" value="" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;" vertex="1" parent="1"><mxGeometry x="40" y="200" width="236" height="34" as="geometry"/></mxCell><mxCell id="17" value="1" style="ellipse;whiteSpace=wrap;html=1;fontSize=11;fontStyle=1;fillColor=#4d4d4d;fontColor=#ffffff;strokeColor=#333333;" vertex="1" parent="1"><mxGeometry x="48" y="207" width="20" height="20" as="geometry"/></mxCell><mxCell id="18" value="Soạn nội dung và lưu nháp" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontSize=12;fontStyle=0;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="74" y="205" width="198" height="24" as="geometry"/></mxCell><mxCell id="19" value="" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f2f2f2;strokeColor=#333333;" vertex="1" parent="1"><mxGeometry x="284" y="200" width="185" height="34" as="geometry"/></mxCell><mxCell id="20" value="2" style="ellipse;whiteSpace=wrap;html=1;fontSize=11;fontStyle=1;fillColor=#4d4d4d;fontColor=#ffffff;strokeColor=#333333;" vertex="1" parent="1"><mxGeometry x="292" y="207" width="20" height="20" as="geometry"/></mxCell><mxCell id="21" value="Rà soát và công bố" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontSize=12;fontStyle=1;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="318" y="205" width="147" height="24" as="geometry"/></mxCell><mxCell id="22" value="" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;" vertex="1" parent="1"><mxGeometry x="477" y="200" width="236" height="34" as="geometry"/></mxCell><mxCell id="23" value="3" style="ellipse;whiteSpace=wrap;html=1;fontSize=11;fontStyle=1;fillColor=#e6e6e6;strokeColor=#333333;" vertex="1" parent="1"><mxGeometry x="485" y="207" width="20" height="20" as="geometry"/></mxCell><mxCell id="24" value="Điều phối viên tạo ca làm" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontSize=12;fontStyle=0;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="511" y="205" width="198" height="24" as="geometry"/></mxCell><mxCell id="25" value="" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;" vertex="1" parent="1"><mxGeometry x="40" y="248" width="920" height="336" as="geometry"/></mxCell><mxCell id="26" value="Nội dung công khai" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontSize=14;fontStyle=1;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="56" y="256" width="400" height="24" as="geometry"/></mxCell><mxCell id="27" value="Ai cũng xem được phần này, kể cả người chưa đăng nhập. Không ghi họ tên, địa chỉ cụ thể hay hoàn cảnh của người được hỗ trợ." style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontSize=12;fontStyle=0;fontColor=#555555;" vertex="1" parent="1"><mxGeometry x="56" y="282" width="880" height="20" as="geometry"/></mxCell><mxCell id="28" value="Tiêu đề" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontSize=12;fontStyle=1;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="56" y="310" width="888" height="22" as="geometry"/></mxCell><mxCell id="29" value="Nêu ngắn gọn việc cần hỗ trợ." style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontSize=10;fontStyle=0;fontColor=#666666;" vertex="1" parent="1"><mxGeometry x="56" y="330" width="888" height="20" as="geometry"/></mxCell><mxCell id="30" value="Bếp ăn cuối tuần" style="rounded=0;whiteSpace=wrap;html=1;align=left;spacingLeft=8;fontSize=12;fillColor=#ffffff;strokeColor=#666666;fontColor=#333333;" vertex="1" parent="1"><mxGeometry x="56" y="348" width="888" height="30" as="geometry"/></mxCell><mxCell id="31" value="Tóm tắt công khai" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontSize=12;fontStyle=1;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="56" y="388" width="888" height="22" as="geometry"/></mxCell><mxCell id="32" value="Mô tả công việc tình nguyện viên sẽ làm, một đến ba câu." style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontSize=10;fontStyle=0;fontColor=#666666;" vertex="1" parent="1"><mxGeometry x="56" y="408" width="888" height="20" as="geometry"/></mxCell><mxCell id="33" value="Phụ nấu và chia suất ăn tại bếp cộng đồng vào sáng Chủ nhật." style="rounded=0;whiteSpace=wrap;html=1;align=left;spacingLeft=8;fontSize=12;fillColor=#ffffff;strokeColor=#666666;fontColor=#333333;verticalAlign=top;spacingTop=6;" vertex="1" parent="1"><mxGeometry x="56" y="426" width="888" height="56" as="geometry"/></mxCell><mxCell id="34" value="Khu vực chung" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontSize=12;fontStyle=1;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="56" y="492" width="888" height="22" as="geometry"/></mxCell><mxCell id="35" value="Chỉ ghi đến phường, xã. Địa chỉ cụ thể ghi ở phần hướng dẫn riêng bên dưới." style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontSize=10;fontStyle=0;fontColor=#666666;" vertex="1" parent="1"><mxGeometry x="56" y="512" width="888" height="20" as="geometry"/></mxCell><mxCell id="36" value="Phường An Bình" style="rounded=0;whiteSpace=wrap;html=1;align=left;spacingLeft=8;fontSize=12;fillColor=#ffffff;strokeColor=#666666;fontColor=#333333;" vertex="1" parent="1"><mxGeometry x="56" y="530" width="888" height="30" as="geometry"/></mxCell><mxCell id="37" value="" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f7f7f7;strokeColor=#666666;dashed=1;" vertex="1" parent="1"><mxGeometry x="40" y="596" width="920" height="166" as="geometry"/></mxCell><mxCell id="38" value="Hướng dẫn điều phối riêng (không bắt buộc)" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontSize=14;fontStyle=1;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="56" y="604" width="500" height="24" as="geometry"/></mxCell><mxCell id="39" value="Chỉ đại diện, điều phối viên của tổ chức và tình nguyện viên đã được phân công mới xem được, và chỉ đến khi ca kết thúc." style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontSize=12;fontStyle=0;fontColor=#555555;" vertex="1" parent="1"><mxGeometry x="56" y="630" width="880" height="20" as="geometry"/></mxCell><mxCell id="40" value="Nội dung hướng dẫn" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontSize=12;fontStyle=1;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="56" y="656" width="888" height="22" as="geometry"/></mxCell><mxCell id="41" value="Bếp ở cuối hẻm 12, đi cửa sau. Gặp chị Mai để nhận tạp dề và phân việc." style="rounded=0;whiteSpace=wrap;html=1;align=left;spacingLeft=8;fontSize=12;fillColor=#ffffff;strokeColor=#666666;fontColor=#333333;verticalAlign=top;spacingTop=6;" vertex="1" parent="1"><mxGeometry x="56" y="676" width="888" height="62" as="geometry"/></mxCell><mxCell id="42" value="Lưu thay đổi" style="rounded=1;whiteSpace=wrap;html=1;arcSize=18;fontSize=12;fillColor=#eeeeee;strokeColor=#999999;fontColor=#888888;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="774" width="112" height="30" as="geometry"/></mxCell><mxCell id="43" value="" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;" vertex="1" parent="1"><mxGeometry x="40" y="818" width="920" height="224" as="geometry"/></mxCell><mxCell id="44" value="Rà soát và công bố" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontSize=15;fontStyle=1;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="56" y="826" width="500" height="26" as="geometry"/></mxCell><mxCell id="45" value="Trước khi công bố, hãy đọc lại đúng những gì người ngoài sẽ nhìn thấy:" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontSize=12;fontStyle=0;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="56" y="856" width="880" height="20" as="geometry"/></mxCell><mxCell id="46" value="" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f2f2f2;strokeColor=#999999;" vertex="1" parent="1"><mxGeometry x="56" y="880" width="888" height="70" as="geometry"/></mxCell><mxCell id="47" value="Bếp ăn cuối tuần" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontSize=12;fontStyle=1;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="68" y="884" width="860" height="20" as="geometry"/></mxCell><mxCell id="48" value="Phụ nấu và chia suất ăn tại bếp cộng đồng vào sáng Chủ nhật." style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontSize=12;fontStyle=0;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="68" y="904" width="860" height="20" as="geometry"/></mxCell><mxCell id="49" value="Khu vực: Phường An Bình" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontSize=12;fontStyle=0;fontColor=#555555;" vertex="1" parent="1"><mxGeometry x="68" y="924" width="860" height="20" as="geometry"/></mxCell><mxCell id="50" value="" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f2f2f2;strokeColor=#666666;" vertex="1" parent="1"><mxGeometry x="56" y="958" width="888" height="32" as="geometry"/></mxCell><mxCell id="51" value="✓" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#333333;fontSize=12;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="64" y="966" width="16" height="16" as="geometry"/></mxCell><mxCell id="52" value="Tôi đã đọc lại nội dung trên và xác nhận không để lộ thông tin của người được hỗ trợ." style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontSize=12;fontStyle=0;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="88" y="960" width="850" height="28" as="geometry"/></mxCell><mxCell id="53" value="Công bố nhu cầu" style="rounded=1;whiteSpace=wrap;html=1;arcSize=18;fontSize=12;fillColor=#4d4d4d;strokeColor=#333333;fontColor=#ffffff;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="56" y="998" width="134" height="36" as="geometry"/></mxCell><mxCell id="54" value="" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;" vertex="1" parent="1"><mxGeometry x="40" y="1054" width="920" height="96" as="geometry"/></mxCell><mxCell id="55" value="Kết thúc nhu cầu" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontSize=15;fontStyle=1;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="56" y="1062" width="500" height="26" as="geometry"/></mxCell><mxCell id="56" value="Nếu việc này không còn cần nữa, bạn có thể hủy nhu cầu khi chưa có ca nào bắt đầu." style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontSize=12;fontStyle=0;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="56" y="1090" width="880" height="20" as="geometry"/></mxCell><mxCell id="57" value="Hủy nhu cầu" style="rounded=1;whiteSpace=wrap;html=1;arcSize=18;fontSize=12;fillColor=#ffffff;strokeColor=#333333;fontColor=#000000;fontStyle=1;dashed=1;" vertex="1" parent="1"><mxGeometry x="56" y="1114" width="105" height="30" as="geometry"/></mxCell><mxCell id="58" value="(khi nhu cầu đã công bố và mọi ca đã xong, chỗ này là nút Đóng nhu cầu)" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontSize=11;fontStyle=2;fontColor=#555555;" vertex="1" parent="1"><mxGeometry x="180" y="1114" width="760" height="30" as="geometry"/></mxCell><mxCell id="59" value="" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#333333;" vertex="1" parent="1"><mxGeometry x="0" y="1174" width="1000" height="30" as="geometry"/></mxCell><mxCell id="60" value="Nền tảng điều phối tình nguyện viên theo kỹ năng. Giờ hiển thị trên trang là giờ Việt Nam." style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontSize=10;fontStyle=0;fontColor=#555555;" vertex="1" parent="1"><mxGeometry x="20" y="1178" width="700" height="22" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>