<mxfile host="app.diagrams.net" type="device"><diagram id="Hinh_3_20_Hoat_dong_Phan_cong" name="Biểu đồ hoạt động chức năng Phân công tình nguyện viên"><mxGraphModel page="1" pageScale="1" pageWidth="895" pageHeight="850" grid="1" gridSize="10" background="#ffffff"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="uml_lane0" value="&lt;div style=&quot;line-height:1;white-space:pre;&quot;&gt;Điều phối viên&lt;/div&gt;" vertex="1" parent="1" style="fontFamily=Times New Roman;fontSize=22;fontColor=#000000;strokeColor=#c52c61;strokeWidth=1.2;fillColor=#ffffcc;html=1;whiteSpace=nowrap;align=center;verticalAlign=middle;shape=swimlane;horizontal=1;startSize=55;fillColor=#f1f1f1;swimlaneFillColor=#ffffff;strokeColor=#a6a6a6;fontStyle=1;align=center;verticalAlign=top;"><mxGeometry as="geometry" x="15" y="15" width="325" height="815"/></mxCell><mxCell id="uml_lane1" value="&lt;div style=&quot;line-height:1;white-space:pre;&quot;&gt;Hệ thống&lt;/div&gt;" vertex="1" parent="1" style="fontFamily=Times New Roman;fontSize=22;fontColor=#000000;strokeColor=#c52c61;strokeWidth=1.2;fillColor=#ffffcc;html=1;whiteSpace=nowrap;align=center;verticalAlign=middle;shape=swimlane;horizontal=1;startSize=55;fillColor=#f1f1f1;swimlaneFillColor=#ffffff;strokeColor=#a6a6a6;fontStyle=1;align=center;verticalAlign=top;"><mxGeometry as="geometry" x="340" y="15" width="540" height="815"/></mxCell><mxCell id="uml_i" value="" vertex="1" parent="1" style="fontFamily=Times New Roman;fontSize=23;fontColor=#000000;strokeColor=#c52c61;strokeWidth=1.2;fillColor=#ffffcc;html=1;whiteSpace=nowrap;align=center;verticalAlign=middle;shape=ellipse;fillColor=#000000;strokeColor=#000000;"><mxGeometry as="geometry" x="180" y="88" width="20" height="20"/></mxCell><mxCell id="uml_choose" value="&lt;div style=&quot;line-height:1;white-space:pre;&quot;&gt;Chọn đăng ký chờ duyệt&lt;br&gt;và nhấn Phân công&lt;/div&gt;" vertex="1" parent="1" style="fontFamily=Times New Roman;fontSize=23;fontColor=#000000;strokeColor