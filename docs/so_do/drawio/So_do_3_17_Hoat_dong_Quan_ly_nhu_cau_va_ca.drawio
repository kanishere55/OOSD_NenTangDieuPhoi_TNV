<mxfile host="app.diagrams.net" type="device"><diagram id="Hinh_3_18_Hoat_dong_Quan_ly_nhu_cau_va_ca" name="Biểu đồ hoạt động Quản lý nhu cầu và ca làm"><mxGraphModel page="1" pageScale="1" pageWidth="860" pageHeight="1300" grid="1" gridSize="10" background="#ffffff"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="uml_lane0" value="&lt;div style=&quot;line-height:1;white-space:pre;&quot;&gt;Đại diện cộng đồng /&lt;br&gt;Điều phối viên&lt;/div&gt;" vertex="1" parent="1" style="fontFamily=Times New Roman;fontSize=22;fontColor=#000000;strokeColor=#c52c61;strokeWidth=1.2;fillColor=#ffffcc;html=1;whiteSpace=nowrap;align=center;verticalAlign=middle;shape=swimlane;horizontal=1;startSize=55;fillColor=#f1f1f1;swimlaneFillColor=#ffffff;strokeColor=#a6a6a6;fontStyle=1;align=center;verticalAlign=top;"><mxGeometry as="geometry" x="15" y="15" width="310" height="1270"/></mxCell><mxCell id="uml_lane1" value="&lt;div style=&quot;line-height:1;white-space:pre;&quot;&gt;Hệ thống&lt;/div&gt;" vertex="1" parent="1" style="fontFamily=Times New Roman;fontSize=22;fontColor=#000000;strokeColor=#c52c61;strokeWidth=1.2;fillColor=#ffffcc;html=1;whiteSpace=nowrap;align=center;verticalAlign=middle;shape=swimlane;horizontal=1;startSize=55;fillColor=#f1f1f1;swimlaneFillColor=#ffffff;strokeColor=#a6a6a6;fontStyle=1;align=center;verticalAlign=top;"><mxGeometry as="geometry" x="325" y="15" width="520" height="1270"/></mxCell><mxCell id="uml_i" value="" vertex="1" parent="1" style="fontFamily=Times New Roman;fontSize=23;fontColor=#000000;strokeColor=#c52c61;strokeWidth=1.2;fillColor=#ffffcc;html=1;whiteSpace=nowrap;align=center;verticalAlign=middle;shape=ellipse;fillColor=#000000;strokeColor=#000000;"><mxGeometry as="geometry" x="160" y="95" width="20" height="20"/></mxCell><mxCell id="uml_choose" value="&lt;div style=&quot;line-height:1;white-space:pre;&quot;&gt;Chọn công bố, tạo ca&lt;br&gt;hoặc hủy nhu cầu/ca&lt;/div&gt;" vertex="1" parent="1" style="fontFamily=Times New Roman;fontSize=23;fontColor=#000000;strokeColor=#c52c61;strokeWidth=1.2;fillColor=#ffffcc;html=1;whiteSpace=nowrap;align=center;verticalAlign=middle;rounded=1;arcSize=15;"><mxGeometry as="geometry" x="40" y="145" width="260" height="62"/></mxCell><mxCell id="uml_lock" value="&lt;div style=&quot;line-height:1;white-space:pre;&quot;&gt;Bắt đầu giao dịch; khóa và đọc dữ liệu&lt;br&gt;liên quan&lt;/div&gt;" vertex="1" parent="1" style="fontFamily=Times New Roman;fontSize=23;fontColor=#000000;strokeColor=#c52c61;strokeWidth=1.2;fillColor=#ffffcc;html=1;whiteSpace=nowrap;align=center;verticalAlign=middle;rounded=1;arcSize=15;"><mxGeometry as="geometry" x="365" y="245" width="410" height="62"/></mxCell><mxCell id="uml_check" value="Kiểm tra quyền theo thao tác.&lt;br&gt;Công bố: Nháp; đúng phiên bản rà soát.&lt;br&gt;Tạo ca: nhu cầu công bố; thời gian,&lt;br&gt;sức chứa, kỹ năng hợp lệ.&lt;br&gt;Hủy ca: trước giờ bắt đầu.&lt;br&gt;Hủy nhu cầu: Nháp/Đã công bố;&lt;br&gt;chưa ca nào bắt đầu." vertex="1" parent="1" style="fontFamily=Times New Roman;fontSize=23;fontColor=#000000;strokeColor=#c52c61;strokeWidth=1.2;fillColor=#ffffcc;html=1;whiteSpace=nowrap;align=center;verticalAlign=middle;rounded=1;arcSize=15;"><mxGeometry as="geometry" x="365" y="350" width="410" height="225"/></mxCell><mxCell id="uml_valid" value="" vertex="1" parent="1" style="fontFamily=Times New Roman;fontSize=23;fontColor=#000000;strokeColor=#c52c61;strokeWidth=1.2;fillColor=#ffffcc;html=1;whiteSpace=nowrap;align=center;verticalAlign=middle;shape=rhombus;"><mxGeometry as="geometry" x="556" y="601" width="28" height="28"/></mxCell><mxCell id="uml_save" value="Công bố: lưu Đã công bố.&lt;br&gt;Tạo ca: lưu Đang mở và kỹ năng.&lt;br&gt;Hủy ca: hủy đăng ký, giữ nhu cầu.&lt;br&gt;Hủy nhu cầu: lưu Đã hủy; hủy ca&lt;br&gt;và đăng ký còn hiệu lực.&lt;br&gt;Giữ lịch sử; không xóa dữ liệu." vertex="1" parent="1" style="fontFamily=Times New Roman;fontSize=23;fontColor=#000000;strokeColor=#c52c61;strokeWidth=1.2;fillColor=#ffffcc;html=1;whiteSpace=nowrap;align=center;verticalAlign=middle;rounded=1;arcSize=15;"><mxGeometry as="geometry" x="365" y="695" width="410" height="177"/></mxCell><mxCell id="uml_commit" value="&lt;div style=&quot;line-height:1;white-space:pre;&quot;&gt;Xác nhận giao dịch của thao tác&lt;/div&gt;" vertex="1" parent="1" style="fontFamily=Times New Roman;fontSize=23;fontColor=#000000;strokeColor=#c52c61;strokeWidth=1.2;fillColor=#ffffcc;html=1;whiteSpace=nowrap;align=center;verticalAlign=middle;rounded=1;arcSize=15;"><mxGeometry as="geometry" x="365" y="920" width="410" height="54"/></mxCell><mxCell id="uml_stored" value="" vertex="1" parent="1" style="fontFamily=Times New Roman;fontSize=23;fontColor=#000000;strokeColor=#c52c61;strokeWidth=1.2;fillColor=#ffffcc;html=1;whiteSpace=nowrap;align=center;verticalAlign=middle;shape=rhombus;"><mxGeometry as="geometry" x="556" y="996" width="28" height="28"/></mxCell><mxCell id="uml_fail" value="&lt;div style=&quot;line-height:1;white-space:pre;&quot;&gt;Hoàn tác; không đổi dữ liệu và trả lý do&lt;/div&gt;" vertex="1" parent="1" style="fontFamily=Times New Roman;fontSize=23;fontColor=#000000;strokeColor=#c52c61;strokeWidth=1.2;fillColor=#ffffcc;html=1;whiteSpace=nowrap;align=center;verticalAlign=middle;rounded=1;arcSize=15;"><mxGeometry as="geometry" x="365" y="1090" width="410" height="54"/></mxCell><mxCell id="uml_result" value="&lt;div style=&quot;line-height:1;white-space:pre;&quot;&gt;Xem kết quả; sửa dữ liệu&lt;br&gt;nếu được yêu cầu&lt;/div&gt;" vertex="1" parent="1" style="fontFamily=Times New Roman;fontSize=23;fontColor=#000000;strokeColor=#c52c61;strokeWidth=1.2;fillColor=#ffffcc;html=1;whiteSpace=nowrap;align=center;verticalAlign=middle;rounded=1;arcSize=15;"><mxGeometry as="geometry" x="40" y="1150" width="260" height="62"/></mxCell><mxCell id="uml_f" value="" vertex="1" parent="1" style="fontFamily=Times New Roman;fontSize=23;fontColor=#000000;strokeColor=#c52c61;strokeWidth=1.2;fillColor=#ffffcc;html=1;whiteSpace=n